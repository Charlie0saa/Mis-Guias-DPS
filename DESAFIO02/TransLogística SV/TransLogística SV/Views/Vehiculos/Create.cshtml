@model TransLogística_SV.Models.VehiculoViewModel

@{
    ViewData["Title"] = "Registrar Vehículo";
}

<h2 class="my-3">Registrar Nuevo Vehículo</h2>

<form asp-action="Create" method="post" class="card p-4 shadow-sm" style="max-width: 600px;">

    <!-- DESPLEGABLE -->
    <div class="mb-3">
        <label class="form-label font-weight-bold">Seleccione Tipo de Vehículo</label>
        <select asp-for="TipoSeleccionado" id="selectTipo" class="form-select" onchange="cambiarTipoCampos()">
            <option value="Automovil">Automóvil</option>
            <option value="Camion">Camión</option>
            <option value="Motocicleta">Motocicleta</option>
            <option value="Batimovil">Batimóvil 🦇</option>
        </select>
    </div>

    <!-- CAMPOS COMUNES PARA TODOS LOS VEHÍCULOS -->
    <div class="mb-3">
        <label asp-for="Placa" class="form-label">Placa</label>
        <input asp-for="Placa" class="form-control" required />
        <span asp-validation-for="Placa" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Marca" class="form-label">Marca</label>
            <input asp-for="Marca" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Modelo" class="form-label">Modelo</label>
            <input asp-for="Modelo" class="form-control" required />
        </div>
    </div>

        <div class="col-md-6 mb-3">
             <label asp-for="Anio" class="form-label">Año</label>
             <input asp-for="Anio" type="number" min="1900" max="2026" class="form-control" required />
             <span asp-validation-for="Anio" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="Kilometraje" class="form-label">Kilometraje</label>
            <input asp-for="Kilometraje" type="number" step="0.1" min="0" max="2000000" class="form-control" required />
        <span asp-validation-for="Kilometraje" class="text-danger"></span>
        </div>
    

    <!-- CAMPOS ESPECÍFICOS (SE ADAPTAN SEGÚN LA ELECCIÓN DEL USUARIO) -->
    <!-- Campo único para Camión -->
    <div id="campoCamion" class="mb-3 campo-especifico" style="display:none;">
        <label asp-for="CapacidadCargaToneladas" class="form-label">Capacidad de Carga (Toneladas)</label>
        <input asp-for="CapacidadCargaToneladas" type="number" step="0.1" class="form-control" />
    </div>

        <!-- Campo único para Automóvil -->
    <div id="campoAuto" class="mb-3 campo-especifico">
                <label asp-for="TipoCombustible" class="form-label">Tipo de Combustible</label>
                <select asp-for="TipoCombustible" class="form-select">
                <option value="Regular">Regular</option>
                <option value="Premium">Premium</option>
                <option value="Diesel">Diesel</option>
                </select>
    </div>

    <!-- Campo único para Motocicleta -->
    <div id="campoMoto" class="mb-3 campo-especifico" style="display:none;">
        <label asp-for="Cilindraje" class="form-label">Cilindraje (cc)</label>
        <input asp-for="Cilindraje" type="number" class="form-control" />
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">Guardar Vehículo</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
    
    <div id="campoBatimovil" class="mb-3 campo-especifico" style="display:none;">
        <div class="form-check form-switch">
            <input asp-for="TienePropulsionJet" class="form-check-input" type="checkbox" id="checkJet">
            <label class="form-check-label fw-bold" for="checkJet">¿Incluir Propulsión Jet?</label>
        </div>
    </div>
</form>

<!-- JAVASCRIPT BÁSICO PARA MOSTRAR/OCULTAR CAMPOS DINÁMICAMENTE -->
<script>
    function cambiarTipoCampos() {
        var tipo = document.getElementById("selectTipo").value;

        // Oculta todos los campos específicos primero
        document.querySelectorAll('.campo-especifico').forEach(el => el.style.display = 'none');

        // Muestra únicamente el div correspondiente al tipo seleccionado
        if (tipo === 'Camion') {
            document.getElementById('campoCamion').style.display = 'block';
        } else if (tipo === 'Motocicleta') {
            document.getElementById('campoMoto').style.display = 'block';
        } else {
            document.getElementById('campoAuto').style.display = 'block';
        }
        else if (tipo === 'Batimovil') {
            document.getElementById('campoBatimovil').style.display = 'block';
        }
</script>