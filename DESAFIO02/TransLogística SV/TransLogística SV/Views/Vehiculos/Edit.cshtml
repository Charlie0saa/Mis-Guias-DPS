@model TransLogística_SV.Models.VehiculoViewModel

@{
    ViewData["Title"] = "Editar Vehículo";
}

<h2 class="my-3">Editar Vehículo (Placa: @Model.Placa)</h2>

<form asp-action="Edit" method="post" class="card p-4 shadow-sm" style="max-width: 600px;">

    <!-- Mantiene fija la placa ya que es la clave del diccionario -->
    <input type="hidden" asp-for="Placa" />
    <input type="hidden" asp-for="TipoSeleccionado" />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Marca" class="form-label">Marca</label>
            <input asp-for="Marca" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Modelo" class="form-label">Modelo</label>
            <input asp-for="Modelo" class="form-control" required />
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Anio" class="form-label">Año</label>
            <input asp-for="Anio" type="number" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Kilometraje" class="form-label">Kilometraje</label>
            <input asp-for="Kilometraje" type="number" step="0.1" class="form-control" required />
        </div>
    </div>

    <!-- Muestra únicamente el campo propio según el tipo de vehículo -->
    @if (Model.TipoSeleccionado == "Camion")
    {
        <div class="mb-3">
            <label asp-for="CapacidadCargaToneladas" class="form-label">Capacidad de Carga (Toneladas)</label>
            <input asp-for="CapacidadCargaToneladas" type="number" step="0.1" class="form-control" />
        </div>
    }
    else if (Model.TipoSeleccionado == "Motocicleta")
    {
        <div class="mb-3">
            <label asp-for="Cilindraje" class="form-label">Cilindraje (cc)</label>
            <input asp-for="Cilindraje" type="number" class="form-control" />
        </div>
    }
    else
    {
        <div class="mb-3">
            <label asp-for="TipoCombustible" class="form-label">Tipo de Combustible</label>
            <select asp-for="TipoCombustible" class="form-select">
                <option value="Regular">Regular</option>
                <option value="Premium">Premium</option>
                <option value="Diesel">Diesel</option>
            </select>
        </div>
    }

    <div class="mt-3">
        <button type="submit" class="btn btn-warning">Actualizar Cambios</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </div>
</form>