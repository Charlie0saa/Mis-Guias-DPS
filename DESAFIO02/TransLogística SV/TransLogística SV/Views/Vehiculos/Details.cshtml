@model TransLogística_SV.Models.Vehiculo

@{
    ViewData["Title"] = "Detalle del Vehículo";
}

<h2 class="my-3">Detalles del Vehículo</h2>

<div class="card p-4 shadow-sm style="max-width: 600px;">
    <dl class="row">
        <dt class="col-sm-4">Tipo de Vehículo</dt>
        <dd class="col-sm-8"><span class="badge bg-info text-dark">@Model.TipoVehiculo</span></dd>

        <dt class="col-sm-4">Placa</dt>
        <dd class="col-sm-8"><strong>@Model.Placa</strong></dd>

        <dt class="col-sm-4">Marca y Modelo</dt>
        <dd class="col-sm-8">@Model.Marca @Model.Modelo</dd>

        <dt class="col-sm-4">Año</dt>
        <dd class="col-sm-8">@Model.Anio</dd>

        <dt class="col-sm-4">Kilometraje</dt>
        <dd class="col-sm-8">@Model.Kilometraje.ToString("N1") km</dd>

        <!-- PATTERN MATCHING EN LA VISTA: Identifica el tipo real para mostrar su atributo particular -->
        @if (Model is TransLogística_SV.Models.Camion c)
        {
            <dt class="col-sm-4">Capacidad de Carga</dt>
            <dd class="col-sm-8">@c.CapacidadCargaToneladas Toneladas</dd>
        }
        else if (Model is TransLogística_SV.Models.Automovil a)
        {
            <dt class="col-sm-4">Tipo de Combustible</dt>
            <dd class="col-sm-8">@a.TipoCombustible</dd>
        }
        else if (Model is TransLogística_SV.Models.Motocicleta m)
        {
            <dt class="col-sm-4">Cilindraje</dt>
            <dd class="col-sm-8">@m.Cilindraje cc</dd>
        }
        else if (Model is TransLogística_SV.Models.Batimovil bat)
        {
            <dt class="col-sm-4">Propulsión Jet</dt>
            <dd class="col-sm-8">@(bat.TienePropulsionJet ? "Sí (Equipado)" : "No")</dd>
        }

        <dt class="col-sm-4">Resumen Generado</dt>
        <dd class="col-sm-8"><em>@Model.ObtenerResumen()</em></dd>

        <dt class="col-sm-4">Mantenimiento Anual</dt>
        <dd class="col-sm-8"><strong class="text-success">$@Model.CalcularCostoMantenimiento().ToString("F2")</strong></dd>
    </dl>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Placa" class="btn btn-warning">Editar</a>
        <a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
    </div>
</div>